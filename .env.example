# ==========================================
# SMART FARMER ASSISTANCE - ENVIRONMENT VARIABLES
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL with Prisma)
# Example: postgresql://postgres:password@localhost:5432/smartfarmer?schema=public
# Neon hosted example: postgresql://user:password@ep-xyz.aws.neon.tech/smartfarmer?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartfarmer?schema=public

# Authentication
JWT_SECRET=smart_farmer_dev_secret_key_change_in_prod_at_least_32_chars
JWT_EXPIRES_IN=7d

# Google Maps API (Optional: interactive map with geocoding/directions)
# Free tier: Google Cloud provides $200 monthly credit.
GOOGLE_MAPS_API_KEY=

# Government Open Agricultural Data (Optional: live Mandi prices)
# Get free API key from https://data.gov.in
DATA_GOV_API_KEY=

# AI Provider Configuration (gemini or openai)
# Free tier: Google AI Studio offers free tier for Gemini models
AI_PROVIDER=gemini
AI_API_KEY=

# Cloudinary (Optional: profile and crop photo storage)
# Free tier available at https://cloudinary.com (25 credits/month)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio SMS (Optional: external SMS alerts)
# Free trial credits available at https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Cloud API / Twilio WhatsApp (Optional)
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Firebase Cloud Messaging (Optional: push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
